    "paper:2006.13801v1": {
      "node_id": "paper:2006.13801v1",
      "node_type": "paper",
      "label": "Instant Image Denoising Plugin for ImageJ using Convolutional Neural Networks",
      "properties": {
        "year": "2020",
        "url": "https://arxiv.org/abs/2006.13801v1",
        "relevance": 0.001,
        "summary": {
          "method": "开发基于卷积神经网络的ImageJ插件，实现荧光显微镜图像去噪。",
          "conclusion": "平均峰值信噪比提升7.5 dB，可在80毫秒内实现即时去噪。",
          "limitation": "摘要未提及具体局限性。"
        }
      }
    },
