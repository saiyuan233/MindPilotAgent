    "paper:2101.07713v1": {
      "node_id": "paper:2101.07713v1",
      "node_type": "paper",
      "label": "Image Denoising using Attention-Residual Convolutional Neural Networks",
      "properties": {
        "year": "2021",
        "url": "https://arxiv.org/abs/2101.07713v1",
        "relevance": 0.001,
        "summary": {
          "method": "提出注意力残差卷积神经网络（ARCNN）用于非盲去噪，并扩展至盲去噪任务。",
          "conclusion": "旨在去除噪声并保留细节，相比非学习方法更具灵活性和有效性。",
          "limitation": "摘要未明确提及具体局限性。"
        }
