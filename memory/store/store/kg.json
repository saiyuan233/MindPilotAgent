    "paper:2309.08197v1": {
      "node_id": "paper:2309.08197v1",
      "node_type": "paper",
      "label": "Hyperspectral Image Denoising via Self-Modulating Convolutional Neural Networks",
      "properties": {
        "year": "2023",
        "url": "https://arxiv.org/abs/2309.08197v1",
        "relevance": 0.001,
        "summary": {
          "method": "提出一种自调制卷积神经网络，用于高光谱图像去噪。",
          "conclusion": "该方法克服了现有方法适应性不足的问题，提升了真实复杂噪声下的去噪性能。",
          "limitation": "现有深度方法在真实复杂噪声下表现欠佳，缺乏对新数据的适应性。"
        }
      }
    },
