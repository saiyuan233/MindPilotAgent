    "paper:2204.12736v2": {
      "node_id": "paper:2204.12736v2",
      "node_type": "paper",
      "label": "A Multi-Head Convolutional Neural Network With Multi-path Attention improves Image Denoising",
      "properties": {
        "year": "2022",
        "url": "https://arxiv.org/abs/2204.12736v2",
        "relevance": 0.0,
        "summary": {
          "method": "提出多头卷积神经网络MHCNN，利用多头接收不同旋转角度图像，并结合图像级多路径注意力机制（MPA）有效整合特征以去噪。",
          "conclusion": "实验表明MHCNN在图像去噪任务中超越了现有方法，有效提升了去噪性能。",
          "limitation": "摘要未明确提及该方法的局限性。"
        }
