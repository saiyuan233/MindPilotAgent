    "paper:2102.09376v1": {
      "node_id": "paper:2102.09376v1",
      "node_type": "paper",
      "label": "NFCNN: Toward a Noise Fusion Convolutional Neural Network for Image Denoising",
      "properties": {
        "year": "2021",
        "url": "https://arxiv.org/abs/2102.09376v1",
        "relevance": 0.001,
        "summary": {
          "method": "提出NFCNN去噪模型，采用多阶段双分支架构，引入融合模块结合预测图像与残差，实施阶段式监督训练。",
          "conclusion": "得益于融合模块，模型具备优异的纹理保持能力，实现了先进的图像去噪性能。",
          "limitation": "摘要未提及具体局限性。"
        }
      }
    },
