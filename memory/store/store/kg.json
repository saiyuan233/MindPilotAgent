    "paper:1704.00524v1": {
      "node_id": "paper:1704.00524v1",
      "node_type": "paper",
      "label": "Block-Matching Convolutional Neural Network for Image Denoising",
      "properties": {
        "year": "2017",
        "url": "https://arxiv.org/abs/1704.00524v1",
        "relevance": 0.0,
        "summary": {
          "method": "提出BMCNN结合NSS与CNN，利用预去噪图像引导块匹配，将相似块整合为3D块并用CNN学习去噪映射。",
          "conclusion": "结合NSS处理规则模式与CNN处理不规则结构的优势，有效提升了图像去噪性能。",
          "limitation": "块匹配过程易受噪声干扰，需依赖预去噪算法生成引导信号。"
        }
      }
    },
