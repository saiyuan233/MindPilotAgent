      "node_id": "paper:1905.11172v1",
      "node_type": "paper",
      "label": "GRDN:Grouped Residual Dense Network for Real Image Denoising and GAN-based Real-world Noise Modeling",
      "properties": {
        "year": "2019",
        "url": "https://arxiv.org/abs/1905.11172v1",
        "relevance": 0.0,
        "summary": {
          "method": "提出分组残差密集网络（GRDN），扩展了RDN架构，利用GRDB作为构建模块。",
          "conclusion": "实验展示了GRDN在图像去噪方面的性能。",
          "limitation": "摘要未明确提及方法局限性，仅指出真实去噪缺乏理想配对数据的挑战。"
