    "paper:2002.08301v1": {
      "node_id": "paper:2002.08301v1",
      "node_type": "paper",
      "label": "Multi-wavelet residual dense convolutional neural network for image denoising",
      "properties": {
        "year": "2020",
        "url": "https://arxiv.org/abs/2002.08301v1",
        "relevance": 0.001,
        "summary": {
          "method": "以MWCNN为骨干，在各层插入残差密集块，利用短期残差学习构建MWRDCNN模型进行图像去噪。",
          "conclusion": "该模型能提取更多特征，保持大感受野并提高计算效率，提升了去噪性能与鲁棒性。",
          "limitation": "摘要文本中断，未明确提及具体局限性。"
        }
      }
    },
