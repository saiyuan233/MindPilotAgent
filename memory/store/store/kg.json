      "node_id": "paper:2107.04857v2",
      "node_type": "paper",
      "label": "Dense-Sparse Deep Convolutional Neural Networks Training for Image Denoising",
      "properties": {
        "year": "2021",
        "url": "https://arxiv.org/abs/2107.04857v2",
        "relevance": 0.001,
        "summary": {
          "method": "提出一种增强的稠密-稀疏-稠密网络训练过程，应用于深度去噪卷积神经网络。",
          "conclusion": "该方法在深度去噪卷积神经网络中实现了相当的去噪性能水平。",
          "limitation": "提供的摘要文本未明确提及所提方法的具体局限性。"
